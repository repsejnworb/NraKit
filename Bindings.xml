<Bindings>
	<!-- Clicks the Open Clams button (Modules/OpenClams.lua); names are set in Lua. -->
	<Binding name="CLICK NraKitOpenClamsButton:LeftButton" header="NRAKIT" category="ADDONS"/>
	<!-- Clicks the Unit Scanner target button (Modules/UnitScanner.lua). -->
	<Binding name="CLICK NraKitScanTargetButton:LeftButton" category="ADDONS"/>
	<!-- Copies a Wowhead link to what's under the mouse (Modules/WowheadLink.lua). -->
	<Binding name="NRAKIT_WOWHEAD_LINK" category="ADDONS">NraKit_CopyWowheadLink()</Binding>
	<!-- Opens the inventory browser (Modules/InventoryBrowser.lua). -->
	<Binding name="NRAKIT_INVENTORY_BROWSER" category="ADDONS">NraKit_ToggleInventoryBrowser()</Binding>
	<!-- Opens player notes (Modules/PlayerNotes.lua). -->
	<Binding name="NRAKIT_PLAYER_NOTES" category="ADDONS">NraKit_TogglePlayerNotes()</Binding>
</Bindings>
